# 让 Git 自己判断文本/二进制，并在仓库里统一存成 LF，检出到 Windows 时自动转 CRLF
* text=auto

# 源码：明确按文本处理（Keil 源码是 GBK 编码，但换行符处理与编码无关，安全）
*.c     text
*.h     text
*.s     text
*.md    text
*.json  text
*.txt   text

# Keil 工程文件：文本，统一换行符，diff 更干净
*.uvprojx text
*.uvoptx  text
*.uvproj  text eol=crlf

# 二进制：禁止任何换行符转换，否则文件会被损坏
*.lib   binary
*.a     binary
*.axf   binary
*.hex   binary
*.bin   binary
*.o     binary
*.pdf   binary
*.png   binary
*.jpg   binary
